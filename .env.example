# disabled: evidence retrieval only; openai_compatible: local or hosted model endpoint
RF_MODEL_MODE=disabled
# Example for a local OpenAI-compatible service, not a requirement to install one now.
RF_MODEL_BASE_URL=http://127.0.0.1:11434/v1
RF_MODEL_NAME=
RF_MODEL_API_KEY=
RF_MODEL_JSON_MODE=0
# Optional Basic auth for a review deployment behind HTTPS. Username: reviewer.
RF_DEMO_PASSWORD=
# Relative to project root. Never commit uploaded PDFs or the database.
RF_DATA_DIR=data
RF_MAX_UPLOAD_MB=50
